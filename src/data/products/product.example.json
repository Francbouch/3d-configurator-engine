        "standard-finishes"
      ],
      "defaultMaterialId": "Blanc"
    },
    "interieur": {
      "label": "Intérieur",
      "allowedCollectionIds": [
        "standard-finishes"
      ],
      "defaultMaterialId": "Blanc"
    }
  },
  "materialCollections": [
    {
      "id": "standard-finishes",
      "label": "Finitions standard",
      "materialIds": [
        "580",
        "581",
        "582",
        "588",
        "Blanc",
        "832",
        "831",
        "592",
        "noir"
      ]
    }
  ],
  "rules": [
    {
      "id": "caisson-non-neutral",
      "enabled": true,
      "targetGroup": "caisson",
      "when": {
