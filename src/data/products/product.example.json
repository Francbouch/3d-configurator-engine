          "Blanc",
          "noir"
        ],
        "selectedFromGroups": [
          "caisson"
        ]
      }
    }
  ],
  "animations": {
    "open": {
      "enabled": false,
      "clip": "Open",
      "closedFrame": 0,
      "openFrame": 80,
      "labelOpen": "Ouvrir le lit",
      "labelClose": "Fermer le lit"
    }
  },
  "configurationFlow": [
    "facade",
    "caisson",
    "interieur"
  ]
